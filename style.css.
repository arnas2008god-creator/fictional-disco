* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f8faf8;
    color: #26352e;
    line-height: 1.7;
}

.container {
    width: 88%;
    max-width: 1100px;
    margin: auto;
}

.header {
    background: #ffffff;
    padding: 20px 0;
    border-bottom: 1px solid #e8eee9;
}

.nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 28px;
    font-weight: bold;
    color: #263f32;
    text-decoration: none;
}

.logo span {
    color: #79a889;
}

nav {
    display: flex;
    gap: 25px;
}

nav a {
    text-decoration: none;
    color: #526258;
    font-size: 14px;
    transition: 0.3s;
}

nav a:hover {
    color: #6a9a7b;
}

.hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
    padding-top: 90px;
    padding-bottom: 90px;
}

.hero-text {
    flex: 1;
}

.tag {
    color: #78a487;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 18px;
}

.hero h1 {
    font-size: 43px;
    line-height: 1.2;
    margin-bottom: 15px;
}

.hero h1 span {
    color: #78a487;
}

.hero h2 {
    font-size: 21px;
    font-weight: normal;
    color: #637269;
    margin-bottom: 18px;
}

.hero-text > p:not(.tag) {
    color: #68756d;
    max-width: 550px;
    margin-bottom: 30px;
}

.main-btn {
    display: inline-block;
    background: #71977d;
    color: white;
    text-decoration: none;
    padding: 12px 25px;
    border-radius: 7px;
    transition: 0.3s;
}

.main-btn:hover {
    background: #52755e;
}

.hero-image {
    flex: 0 0 330px;
}

.hero-image img {
    width: 100%;
    height: 390px;
    object-fit: cover;
    border-radius: 18px;
    border: 8px solid white;
    box-shadow: 0 12px 35px rgba(40, 70, 50, 0.10);
}

.section {
    padding-top: 65px;
    padding-bottom: 65px;
}

.section-title {
    font-size: 32px;
    margin-bottom: 30px;
    color: #2d4435;
}

.about-card,
.education-card,
.contact-card {
    background: white;
    padding: 30px;
    border-radius: 12px;
    border: 1px solid #e9eee9;
    box-shadow: 0 5px 20px rgba(30, 60, 40, 0.04);
}

.about-card p {
    color: #68756d;
    margin-bottom: 15px;
}

.about-card p:last-child {
    margin-bottom: 0;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.card {
    background: white;
    padding: 28px;
    border-radius: 12px;
    border: 1px solid #e9eee9;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(30, 60, 40, 0.08);
}

.card-icon {
    font-size: 30px;
    margin-bottom: 15px;
}

.card h3 {
    font-size: 19px;
    margin-bottom: 15px;
    color: #35523f;
}

.card ul,
.achievement-list {
    padding-left: 20px;
    color: #68756d;
}

.card li,
.achievement-list li {
    margin-bottom: 9px;
}

.year {
    display: inline-block;
    background: #edf5ef;
    color: #60836a;
    padding: 5px 13px;
    border-radius: 20px;
    margin-bottom: 15px;
    font-size: 13px;
}

.education-card h3 {
    font-size: 22px;
    margin-bottom: 12px;
    color: #35523f;
}

.education-card p,
.contact-card p {
    color: #68756d;
    margin-bottom: 8px;
}

.contact-card strong {
    color: #35523f;
}

footer {
    text-align: center;
    padding: 25px;
    background: #edf3ee;
    color: #718075;
    font-size: 13px;
}

@media (max-width: 768px) {
    .nav {
        flex-direction: column;
        gap: 15px;
    }

    nav {
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    .hero {
        flex-direction: column-reverse;
        text-align: center;
        padding-top: 50px;
        padding-bottom: 50px;
    }

    .hero-image {
        flex: auto;
        width: 240px;
    }

    .hero-image img {
        height: 290px;
    }

    .hero h1 {
        font-size: 32px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .section-title {
        font-size: 27px;
    }
}
